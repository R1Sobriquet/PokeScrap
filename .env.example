# --- App ---
APP_ENV=development
APP_TIMEZONE=Europe/Paris
API_PORT=8000
FRONTEND_PORT=5173

# --- Auth (mono-utilisateur) ---
JWT_SECRET=change_me
JWT_EXPIRE_MIN=15                   # access court : le refresh cookie maintient la session
REFRESH_EXPIRE_DAYS=30              # durée du cookie refresh httpOnly (rotatif, révocable)
COOKIE_SECURE=false                 # true en production derrière Caddy/TLS
RATE_LIMIT_ENABLED=true             # limite login/register/forgot par IP (429)
ADMIN_USERNAME=erwann
ADMIN_PASSWORD=change_me            # haché en bcrypt au premier démarrage
ADMIN_EMAIL=admin@localhost         # email de la ligne users de l'admin (multi-user)

# --- Multi-utilisateurs (SaaS) : emails transactionnels + origine publique ---
# Sans SMTP_HOST, les emails (vérification, reset) sont LOGGÉS en console (dev).
PUBLIC_ORIGIN=http://localhost:5173 # base des liens envoyés par email (verify/reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PokéAlpha <no-reply@localhost>

# --- MySQL ---
DB_HOST=db
DB_PORT=3306
DB_NAME=pokemon_arbitrage
DB_USER=app
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me

# --- PokeTrace (clé serveur uniquement, JAMAIS côté frontend) ---
POKETRACE_API_KEY=
POKETRACE_BASE_URL=https://api.poketrace.com/v1

# --- PSA Public API ---
# Réel : token statique généré dans le compte PSA (prioritaire). Username/password
# = repli OAuth2 (spec d'origine). Base réelle : api.psacard.com/publicapi.
PSA_API_TOKEN=
PSA_API_USERNAME=
PSA_API_PASSWORD=
PSA_BASE_URL=https://api.psacard.com/publicapi

# --- Discord (bot gateway) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ACHATS=
DISCORD_CHANNEL_VENTES=
DISCORD_CHANNEL_PORTEFEUILLE=
DISCORD_CHANNEL_SYSTEME=
DISCORD_CHANNEL_RESTOCK=             # PokéStock FR : nouveau canal alertes restock/nouveaux SKU
DISCORD_CHANNEL_HEALTH=             # Moat marché : canal du moniteur santé des sources
DISCORD_CHANNEL_MARKETWATCH=       # Market Intel : digest « cartes à cibler » (repli #systeme)
DISCORD_PING_USER_ID=

# --- Telegram (PokéStock FR — alertes restock) ---
# Prérequis : créer un bot via @BotFather (→ token), puis récupérer le chat_id
# cible (envoyer un message au bot, lire getUpdates, ou via @userinfobot).
# Activation : settings telegram_enabled=true. Secrets ICI, jamais en base.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Moat de données marché (clés API : settings OU env ; settings prioritaire) ---
# Tout est OFF par défaut (settings marketdata_enabled + marketdata_<source>_enabled).
# PPT : quota free 100 req/jour → watched-only + cap/run. eBay : OAuth Browse.
PPT_API_KEY=                         # PokemonPriceTracker (Bearer) — ou settings ppt_api_key
EBAY_CLIENT_ID=                      # eBay Browse OAuth — ou settings ebay_client_id
EBAY_CLIENT_SECRET=                  # eBay Browse OAuth — ou settings ebay_client_secret

# --- Market Intelligence (cartes sous-valorisées ; monitoring, aucun achat auto) ---
# OFF par défaut (settings marketwatch_enabled). Clé de jointure = card_id TCGdex.
# Cardmarket = FICHIERS publics quotidiens (URL http(s) OU chemin local) ; l'API et
# le scraping sont hors-jeu. Renseigner les 2 fichiers pour activer la source.
MARKETWATCH_CARDMARKET_PRODUCTS_URL=    # catalogue produits (idProduct ↔ carte) — url ou chemin
MARKETWATCH_CARDMARKET_PRICEGUIDE_URL=  # price-guide (low/avg/trend par idProduct) — url ou chemin
MARKETWATCH_CARDMARKET_LANG=EN          # langue attribuée aux snapshots Cardmarket (EN|JP|FR)
# PPT & eBay actifs réutilisent PPT_API_KEY / EBAY_CLIENT_* ci-dessus.
# Réglages métier (table settings) : marketwatch_enabled, marketwatch_cardmarket_enabled,
# marketwatch_ppt_enabled, marketwatch_ebay_enabled, marketwatch_min_liquidity,
# marketwatch_buy_url_template, fx_usd_eur.

# --- Scraper ---
SCRAPE_VINTED_ENABLED=true
SCRAPE_LBC_ENABLED=true
SCRAPE_INTERVAL_MIN=45
SCRAPE_USER_AGENT=
# Cookies de session OPTIONNELS (compte perso dédié), au format JSON Playwright
# (liste d'objets cookie). Laisser vide = scraping anonyme. Jamais d'identifiants
# en clair : seulement des cookies exportés.
SCRAPE_VINTED_COOKIES=
SCRAPE_LBC_COOKIES=
# Anti-détection légère. SCRAPE_HEADLESS=false nécessite un affichage (xvfb) ;
# en conteneur, laisser true. State (cookies persistés) + screenshots de debug.
SCRAPE_HEADLESS=true
SCRAPE_STATE_DIR=/app/state
SCRAPE_DEBUG_DIR=/tmp/scraper-debug

# --- Jobs (cron) ---
JOB_REFRESH_PRICES=0 6 * * *
JOB_REFRESH_HISTORY=0 4 * * *
JOB_KPI_SNAPSHOT=55 23 * * *

# --- Logs ---
LOG_LEVEL=info
LOG_REDACT_SECRETS=true            # masque les secrets dans les logs JSON

# --- Sauvegardes (J9) ---
BACKUP_DIR=./backups               # dépôt local des dumps chiffrés
BACKUP_OFFSITE_TARGET=             # ex. rclone:remote:pokescrap ou user@host:/path (scp)
BACKUP_ENCRYPTION_KEY=             # recipient age (age1...) OU empreinte/clé GPG
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_SCHEDULE=0 3 * * *          # 03:00 (cron hôte)
